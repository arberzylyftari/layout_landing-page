    document.addEventListener("click", function(e) {
        var menu = document.getElementById("menu");
        var menuToggle = document.querySelector(".header__menu-toggle");
        if (menu && window.location.hash === "#menu") {
            if (!menu.contains(e.target) && !menuToggle.contains(e.target)) window.location.hash = "";
        }
    });
    // Form submission success message
    var contactForm = document.querySelector(".contact__form");
    if (contactForm) contactForm.addEventListener("submit", function() {
        // Form is already set to reset in HTML, but we can add success feedback
        setTimeout(function() {
            // eslint-disable-next-line no-alert
            window.alert("Thank you for your message! We'll get back to you soon.");
        }, 100);
